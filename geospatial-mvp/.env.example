# ---------------------------------------------------------------------------
# Only variables with the GEO_ prefix are read by the application.
# Copy this file to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

GEO_ENVIRONMENT=local
GEO_LOG_LEVEL=INFO

# Storage roots (defaults are relative to the project root)
GEO_DATA_DIR=./data
GEO_UPLOADS_DIR=./data/uploads
GEO_OUTPUTS_DIR=./data/outputs

# Limits
GEO_MAX_UPLOAD_BYTES=157286400
GEO_MAX_IMAGE_PIXELS=120000000
GEO_THUMBNAIL_MAX_SIZE=1024
